# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Server
PORT=4000
CLIENT_URL="https://optik-kayumanis-frontend.vercel.app/"
# Opsional: set ini di production kalau server ada di belakang reverse proxy/HTTPS,
# supaya URL gambar yang diupload (lihat /uploads) selalu benar. Kalau dikosongkan,
# otomatis dipakai protokol+host dari request yang masuk.
# PUBLIC_API_URL="https://api.optikkayumanis.com"

# Auth
JWT_SECRET="change-this-to-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# --- Notifikasi Invoice (opsional, tapi disarankan) ---

# Email — SMTP apa saja bisa dipakai (Gmail, Zoho, provider hosting, dll)
# Untuk Gmail: aktifkan 2FA lalu buat "App Password" di
# https://myaccount.google.com/apppasswords, jangan pakai password akun biasa.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="tokokamu@gmail.com"
SMTP_PASS="app-password-16-digit-dari-google"
SMTP_FROM="\"Optik Kayumanis\" <tokokamu@gmail.com>"

# WhatsApp — via Fonnte (https://fonnte.com)
# Daftar akun, hubungkan nomor WA kamu (scan QR), lalu salin token device
# dari dashboard Fonnte ke sini. Ada kuota gratis untuk testing.
FONNTE_TOKEN="token-dari-dashboard-fonnte"

WEBSITE_TOKEN="ganti-dengan-token-rahasia-kamu-sendiri"

# --- Cloudflare R2 (penyimpanan gambar) ---
# 1. Buat bucket di Dashboard Cloudflare > R2 Object Storage.
# 2. Bikin API Token (R2 > Manage API Tokens) dengan izin Object Read & Write,
#    lalu salin Access Key ID & Secret Access Key ke bawah ini.
# 3. Account ID ada di Dashboard Cloudflare, sidebar kanan halaman R2.
# 4. Untuk akses publik: buka bucket > Settings > Public Access > Enable,
#    lalu salin URL "r2.dev" yang muncul ke R2_PUBLIC_URL (tanpa trailing slash).
#    Kalau sudah punya custom domain, pakai itu saja.
R2_ACCOUNT_ID="account-id-cloudflare-kamu"
R2_ACCESS_KEY_ID="access-key-id-r2-kamu"
R2_SECRET_ACCESS_KEY="secret-access-key-r2-kamu"
R2_BUCKET_NAME="nama-bucket-r2-kamu"
R2_PUBLIC_URL="https://pub-xxxxxxxxxxxxxxxx.r2.dev"
